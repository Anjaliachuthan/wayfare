{
  "expo": {
    "name": "Wayfare",
    "slug": "wayfare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayfare.app"
    },
    "android": {
      "package": "com.wayfare.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wayfare uses your location to set your pickup point."
        }
      ],
      "expo-status-bar"
    ]
  }
}
